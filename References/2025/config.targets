<Project>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Azure DevOps Server 2025 ships server assemblies with version 20.x.
      Keep client NuGet packages at 19.225.2 and use local ADO binaries for
      the server/runtime assemblies that require 20.x dependencies.
    -->
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" Version="19.225.2">
      <IncludeAssets>All</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.TeamFoundationServer.ExtendedClient" Version="19.225.2">
      <IncludeAssets>All</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Services.Client" Version="19.225.2">
      <IncludeAssets>All</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Services.InteractiveClient" Version="19.225.2">
      <IncludeAssets>All</IncludeAssets>
    </PackageReference>
    <PackageReference Update="System.Net.Http" Version="4.3.4">
      <IncludeAssets>All</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManyConsole" Version="2.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net480</TargetFramework>
    <DefineConstants>$(DefineConstants);ADOS2025;ADOS2022u2;ADOS2022u1;ADOS2022;ADOS2020;ADOS2019u1;ADOS2019;TFS2018;TFS2017u2;TFS2017;TFS2015u2;TFS2015u1;TFS2015</DefineConstants>
    <RepositoryAdoAssemblies>$(MSBuildThisFileDirectory)..\..\ADO</RepositoryAdoAssemblies>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)'=='' and '$(MSBuildRuntimeType)' != 'Core'">$(Registry:HKEY_LOCAL_MACHINE\Software\Microsoft\TeamFoundationServer\20.0@InstallPath)</TfsInstallationDirectory>
    <TfsInstallationDirectory Condition="'$(TfsInstallationDirectory)'=='' and '$(MSBuildRuntimeType)' != 'Core'">$(Registry:HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\TeamFoundationServer\20.0@InstallPath)</TfsInstallationDirectory>
    <ServerAssemblies Condition="'$(TfsInstallationDirectory)'!=''">$(TfsInstallationDirectory)\Application Tier\Web Services\bin</ServerAssemblies>
    <ServerAssemblies Condition="'$(TfsInstallationDirectory)'=='' and Exists('$(RepositoryAdoAssemblies)\Microsoft.TeamFoundation.Framework.Server.dll')">$(RepositoryAdoAssemblies)</ServerAssemblies>
    <ServerAssemblies Condition="'$(ServerAssemblies)'==''">$(MSBuildThisFileDirectory)</ServerAssemblies>
    <ToolsAssemblies Condition="'$(TfsInstallationDirectory)'!=''">$(TfsInstallationDirectory)\Application Tier\Tools</ToolsAssemblies>
    <ToolsAssemblies Condition="'$(TfsInstallationDirectory)'=='' and Exists('$(RepositoryAdoAssemblies)\Microsoft.TeamFoundation.Client.dll')">$(RepositoryAdoAssemblies)</ToolsAssemblies>
    <ToolsAssemblies Condition="'$(ToolsAssemblies)'==''">$(MSBuildThisFileDirectory)</ToolsAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server Assemblies -->
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.Common.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.Framework.Server.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.Server.Types.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.Server.Core.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.WorkItemTracking.Server.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.WorkItemTracking.Server.DataAccessLayer.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.WorkItemTracking.Server.DataServices.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.Azure.Boards.CssNodes.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.TeamFoundation.Core.WebApi.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.VisualStudio.Services.Common.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\Microsoft.VisualStudio.Services.WebApi.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ServerAssemblies)\System.Collections.Immutable.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
